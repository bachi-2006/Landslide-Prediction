# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# New Supabase key names are also supported by the backend:
# SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# SUPABASE_SECRET_KEY=your_supabase_secret_key

# OpenRouteService API Key
ORS_API_KEY=your_ors_api_key

# Firebase Configuration
FIREBASE_SERVER_KEY=your_firebase_server_key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CREDENTIALS_JSON=C:\path\to\firebase-service-account.json

# Frontend (Vite) Configuration
VITE_API_URL=/api
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_VAPID_KEY=your_public_vapid_key

# CORS origins (comma-separated) for the backend
CORS_ORIGINS=http://localhost:5173

# Emergency SMS Gateway Configuration (Optional)
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key
EMERGENCY_SMS_RECIPIENTS=+919876543210,+919876543211
